# Copy to .env and fill in. NEVER commit the real .env.
# Smartsheet personal access token (Account > Apps & Integrations > API Access)
SMARTSHEET_ACCESS_TOKEN=
# Target sheet id. Leave blank and run `rsi setup-sheet` to create one.
SMARTSHEET_SHEET_ID=
# Optional: only needed when ai.enabled is true in project-config.yaml
ANTHROPIC_API_KEY=
